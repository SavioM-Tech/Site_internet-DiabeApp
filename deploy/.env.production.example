# ──────────────────────────────────────────────────────────────────────────
# .env de PRODUCTION — Site vitrine DiabeApp (diabeapp.com)
#
# À copier sur le VPS en tant que /var/www/diabeapp/.env puis :
#   php artisan key:generate        (génère un APP_KEY unique pour la prod)
#   php artisan config:cache
#
# NE JAMAIS committer ce fichier. Remplir les *** secrets *** ci-dessous.
# ──────────────────────────────────────────────────────────────────────────

APP_NAME="Diabe-App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://diabeapp.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Site vitrine sans base de données : cache/session/queue en fichier.
# (Si tu veux brancher MySQL plus tard, voir le bloc DB commenté en bas.)
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (PROD) ────────────────────────────────────────────────────────────
# SMTP réel (ex. Infomaniak : mail.infomaniak.com / 587 / TLS).
# Remplace les identifiants Mailtrap par les vrais.
MAIL_MAILER=smtp
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_USERNAME=contact@diabeapp.com
MAIL_PASSWORD=***A_REMPLIR***
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@diabeapp.com"
MAIL_FROM_NAME="Diabe-App"

# ─── Stripe (PROD = clés LIVE) ──────────────────────────────────────────────
# Récupère les clés "live" depuis le dashboard Stripe (pas les pk_test/sk_test).
STRIPE_KEY=***pk_live_A_REMPLIR***
STRIPE_SECRET=***sk_live_A_REMPLIR***

VITE_APP_NAME="${APP_NAME}"

# ─── (Optionnel) MySQL dédié si besoin un jour ──────────────────────────────
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=diabeapp
# DB_USERNAME=diabeapp
# DB_PASSWORD=***A_REMPLIR***
